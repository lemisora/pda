<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pda.client.ClientController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Host:" />
        <TextField fx:id="hostField" text="127.0.0.1" prefWidth="120" />
        <Label text="Port:" />
        <TextField fx:id="portField" text="8000" prefWidth="60" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Command:" />
        <ComboBox fx:id="commandCombo" prefWidth="150" />
        <TextField fx:id="dataField" promptText="Message Payload" HBox.hgrow="ALWAYS" />
        <Button text="Send" onAction="#handleSend" />
    </HBox>

    <TextArea fx:id="logArea" editable="false" prefHeight="300.0" prefWidth="500.0" wrapText="true" />
</VBox>
